{% assign trmnl.user.locale = trmnl.user.locale | default: "en-US" %}
{% template glance_card_pollen %}
{% assign pollen_segments_local = pollen_count | plus: 0 %}
{% if pollen_segments_local > 12 %}
{% assign pollen_segments_local = 12 %}
{% endif %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="label label--small{% if large_label %} lg:label--base{% endif %}">Pollen Count</span>
    <span class="value {% if compact %}value--large{% else %}value--large lg:value--xlarge{% endif %} py--1" data-value-format="true" data-value-locale="{{ trmnl.user.locale }}">{{ pollen_count }}</span>
    <div class="progress-dots{% if compact %} progress-dots--xsmall{% endif %}" aria-hidden="true">
      <div class="track">
        {% for i in (1..12) %}
        <div class="dot{% if pollen_segments_local > 0 and i < pollen_segments_local %} dot--filled{% elsif i == pollen_segments_local and pollen_segments_local > 0 %} dot--current{% endif %}"></div>
        {% endfor %}
      </div>
    </div>
    <span class="label label--small">{% render 'format_trigger_summary', properties: today %}</span>
  </div>
</div>
{% endtemplate %}

{% template glance_card_aqi %}
{% assign aqi_band_local = 1 %}
{% if aqi_value > 50 %}
{% assign aqi_band_local = 2 %}
{% endif %}
{% if aqi_value > 100 %}
{% assign aqi_band_local = 3 %}
{% endif %}
{% if aqi_value > 150 %}
{% assign aqi_band_local = 4 %}
{% endif %}
{% if aqi_value > 200 %}
{% assign aqi_band_local = 5 %}
{% endif %}
{% if aqi_value > 300 %}
{% assign aqi_band_local = 6 %}
{% endif %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="label label--small{% if large_label %} lg:label--base{% endif %}">Air Quality Index</span>
    <span class="value {% if compact %}value--large{% else %}value--large lg:value--xlarge{% endif %} py--1" data-value-format="true" data-value-locale="{{ trmnl.user.locale }}">{{ aqi_value }}</span>
    <div class="progress-dots{% if compact %} progress-dots--xsmall{% endif %} lg:progress-dots--base" aria-hidden="true">
      <div class="track">
        {% for i in (1..6) %}
        <div class="dot{% if aqi_band_local > 0 and i < aqi_band_local %} dot--filled{% elsif i == aqi_band_local %} dot--current{% endif %}"></div>
        {% endfor %}
      </div>
    </div>
    <span class="label label--small">EPA band: {{ today.Category }} • {{ today.ResponsiblePollutant }}</span>
  </div>
</div>
{% endtemplate %}

{% template format_pollen_label %}
{% if properties.PollenCount > 0 %}
{{ properties.PollenType }}, {{ properties.PollenDescription }}
{% else %}
No pollen to report!
{% endif %}
{% endtemplate %}

{% template format_trigger_summary %}
{% if properties.PollenCount > 0 %}
{{ properties.PollenType }}, {{ properties.PollenDescription }}
{% else %}
No pollen to report
{% endif %}
{% endtemplate %}

{% template historical_table %}
<table class="table table--condensed" data-table-max-height="auto" data-table-limit="true" table-overflow-counter="false">
  <thead>
    <tr>
      <th><span class="label {% if narrow %}label--small lg:label--base{% else %}label--base lg:label--large{% endif %}">Date</span></th>
      <th><span class="label {% if narrow %}label--small lg:label--base{% else %}label--base lg:label--large{% endif %} text--center">{% if narrow %}Count{% else %}Pollen Count{% endif %}</span></th>
      <th><span class="label {% if narrow %}label--small lg:label--base{% else %}label--base lg:label--large{% endif %}">Type</span></th>
      <th><span class="label {% if narrow %}label--small lg:label--base{% else %}label--base lg:label--large{% endif %} text--center">AQI</span></th>
      <th><span class="label {% if narrow %}label--small lg:label--base{% else %}label--base lg:label--large{% endif %}">&nbsp;</span></th>
      {% unless narrow %}
      <th><span class="label label--base lg:label--large">Contributor</span></th>
      {% endunless %}
    </tr>
  </thead>
  <tbody id="pollen-tbody">
    {% for row in features offset: 1 %}
    <tr>
      <td><span class="label {% if narrow %}label--small lg:label--base{% else %}label--small lg:label--base{% endif %}">{{ row.properties.ReportDateTime | divided_by: 1000 | date: '%B %-d' }}</span></td>
      <td class="text--center"><span class="value value--xxsmall lg:value--xsmall value--tnums" data-value-format="true" data-value-locale="{{ trmnl.user.locale }}">{{ row.properties.PollenCount }}</span></td>
      <td><span class="label {% if narrow %}label--small lg:label--base{% else %}label--small lg:label--base{% endif %}">{% render 'format_pollen_label', properties: row.properties %}</span></td>
      <td class="text--center"><span class="value value--xxsmall lg:value--xsmall value--tnums" data-value-format="true" data-value-locale="{{ trmnl.user.locale }}">{{ row.properties.AQI }}</span></td>
      <td><span class="label {% if narrow %}label--small lg:label--base{% else %}label--small lg:label--base{% endif %}">{{ row.properties.Category }}</span></td>
      {% unless narrow %}
      <td><span class="label label--small lg:label--base">{{ row.properties.ResponsiblePollutant }}</span></td>
      {% endunless %}
    </tr>
    {% endfor %}
  </tbody>
</table>
{% endtemplate %}
